# Copy to .env and fill in. .env is git-ignored.

# Cloud LLM (OpenAI-compatible endpoint; provider decided later)
LLM_BASE_URL=
LLM_API_KEY=

# Local LLM (Ollama or vLLM, OpenAI-compatible)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# ERP + QMS database
ERPQMS_DSN=host=localhost user=postgres password=postgres dbname=erpqms

# Optional: openFDA API key (raises rate limits; works without one)
OPENFDA_API_KEY=
